    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/DDoSAttack4">
        <rdf:type rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/DDoSAttack"/>
