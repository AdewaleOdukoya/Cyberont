<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity#"
     xml:base="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:cybersecurity="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/">
    <owl:Ontology rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity">
        <owl:versionIRI rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/2.0.0"/>
        <rdfs:comment xml:lang="en">Version 2 of the cybersecurity incident ontology. Extends v1 with a standards-grounded, closure-based severity model (FIPS 199 asset criticality x CVSS v3.1 band / MITRE ATT&amp;CK Impact tactic, combined following the qualitative risk matrix of NIST SP 800-30 Rev. 1).</rdfs:comment>
        <rdfs:label xml:lang="en">CyberOnt: Cybersecurity Incident Ontology</rdfs:label>
        <owl:versionInfo>2.0.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/source -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType">
        <rdfs:comment xml:lang="en">How the entity relates to an external standard: reused, aligned, extended or new.</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#seeAlso -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#closeMatch -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#relatedMatch -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#relatedMatch"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/affectsAsset -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/affectsAsset">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Incident"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset"/>
        <rdfs:comment xml:lang="en">Links an incident to an asset whose confidentiality, integrity or availability it impacts.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/causedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/causedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Incident"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Actor"/>
        <rdfs:comment xml:lang="en">Links an incident to the actor responsible for it.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/exploitsVulnerability -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/exploitsVulnerability">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Vulnerability"/>
        <rdfs:comment xml:lang="en">Links a threat to a weakness it leverages.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/generatedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/generatedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Alert"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityControl"/>
        <rdfs:comment xml:lang="en">Links an alert to the sensor or control that raised it.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasVulnerability -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasVulnerability">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Vulnerability"/>
        <rdfs:comment xml:lang="en">Links an asset to a vulnerability present on it.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/involvesThreat -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/involvesThreat">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Incident"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat"/>
        <rdfs:comment xml:lang="en">Links an incident to a threat (attack) involved in it.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/mitigatesThreat -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/mitigatesThreat">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityControl"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat"/>
        <rdfs:comment xml:lang="en">Links a control to a threat it counters.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/mitigatesVulnerability -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/mitigatesVulnerability">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityControl"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Vulnerability"/>
        <rdfs:comment xml:lang="en">Links a control to a vulnerability it reduces.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/partOfTactic -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/partOfTactic">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTechnique"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTactic"/>
        <rdfs:comment xml:lang="en">Links an ATT&amp;CK technique to the tactic(s) under which ATT&amp;CK lists it.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/protectsAsset -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/protectsAsset">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityControl"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset"/>
        <rdfs:comment xml:lang="en">Links a control to an asset it protects (v1 name: protectsAssets).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/reportsIncident -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/reportsIncident">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Alert"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Incident"/>
        <rdfs:comment xml:lang="en">Links an alert to the incident it reports.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/targetsAsset -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/targetsAsset">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset"/>
        <rdfs:comment xml:lang="en">Links a threat to an asset it targets (v1 name: targetsAssets).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/usesTechnique -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/usesTechnique">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTechnique"/>
        <rdfs:comment xml:lang="en">Links a threat to a MITRE ATT&amp;CK technique it employs.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasAttackID -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasAttackID">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTactic"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTechnique"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">MITRE ATT&amp;CK identifier, e.g. T1486 or TA0040.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCVEIdentifier -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCVEIdentifier">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Vulnerability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">CVE identifier, where one exists.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCVSSScore -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCVSSScore">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Vulnerability"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10.0</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">CVSS v3.1 base score (0.0-10.0). Functional: one base score per vulnerability record.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCVSSVector -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCVSSVector">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Vulnerability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">CVSS v3.1 vector string.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCriticality -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCriticality">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>High</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>Low</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>Moderate</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Business criticality of an asset expressed as a FIPS 199 potential-impact level. Functional.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasHostname -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasHostname">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Host name of an asset.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasIPAddress -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasIPAddress">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">IP address of an asset.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasStatus -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasStatus">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Alert"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Incident"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Workflow status, e.g. Open or Closed.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasTimestamp -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasTimestamp">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Alert"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Incident"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Time the incident or alert was recorded (v1 used xsd:string).</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Actor -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Actor">
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">An agent involved in a security event.</rdfs:comment>
        <skos:closeMatch>STIX 2.1 identity / threat-actor</skos:closeMatch>
        <skos:closeMatch>UCO uco:Attacker (for ThreatActor)</skos:closeMatch>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Alert -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Alert">
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">A notification raised by a security control.</rdfs:comment>
        <skos:closeMatch>STIX 2.1 sighting SRO</skos:closeMatch>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Antivirus -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Antivirus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityControl"/>
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Application -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Application">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset"/>
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTactic -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTactic">
        <cybersecurity:alignmentType>reused</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">A MITRE ATT&amp;CK tactic (adversary goal).</rdfs:comment>
        <rdfs:seeAlso rdf:resource="https://attack.mitre.org/tactics/enterprise/"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTechnique -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTechnique">
        <cybersecurity:alignmentType>reused</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">A MITRE ATT&amp;CK technique (how a goal is achieved).</rdfs:comment>
        <rdfs:seeAlso rdf:resource="https://attack.mitre.org/techniques/enterprise/"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/BackupSystem -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/BackupSystem">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityControl"/>
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/BruteForceAttack -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/BruteForceAttack">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/usesTechnique"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/T1110"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
        <rdfs:seeAlso rdf:resource="https://attack.mitre.org/techniques/T1110/"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CriticalAsset -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CriticalAsset">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCriticality"/>
                        <owl:hasValue>High</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <cybersecurity:alignmentType>extended</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">Asset whose compromise would have a severe or catastrophic adverse effect (FIPS 199 HIGH). Defined, not tagged (v1 asserted it).</rdfs:comment>
        <rdfs:seeAlso rdf:resource="https://doi.org/10.6028/NIST.FIPS.199"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CriticalVulnerability -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CriticalVulnerability">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Vulnerability"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCVSSScore"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">9.0</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <cybersecurity:alignmentType>reused</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">CVSS v3.1 rating Critical.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset">
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">Any digital resource of value to the organisation.</rdfs:comment>
        <skos:closeMatch>NIST CSF 2.0 ID.AM (asset inventory); STIX 2.1 infrastructure SDO</skos:closeMatch>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/DDoSAttack -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/DDoSAttack">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/usesTechnique"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/T1498"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
        <rdfs:seeAlso rdf:resource="https://attack.mitre.org/techniques/T1498/"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/DDoSMitigationService -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/DDoSMitigationService">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityControl"/>
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Database -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Database">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset"/>
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/ExternalAttacker -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/ExternalAttacker">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/ThreatActor"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Insider"/>
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">A threat actor outside the organisation.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/FirewallRule -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/FirewallRule">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityControl"/>
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/HighImpactThreat -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/HighImpactThreat">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/usesTechnique"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/ImpactTechnique"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <cybersecurity:alignmentType>new</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">Threat employing at least one ATT&amp;CK Impact technique.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/HighSeverityIncident -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/HighSeverityIncident">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Incident"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/affectsAsset"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CriticalAsset"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/involvesThreat"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SevereThreat"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <cybersecurity:alignmentType>new</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">Matrix cell: critical asset x severe threat.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/ImpactTechnique -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/ImpactTechnique">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTechnique"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/partOfTactic"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/TA0040"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <cybersecurity:alignmentType>new</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">Technique listed under the ATT&amp;CK Impact tactic (TA0040): it directly degrades availability or integrity.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Incident -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Incident">
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">An occurrence that jeopardises an asset (NIST SP 800-61).</rdfs:comment>
        <skos:closeMatch>STIX 2.1 incident SDO</skos:closeMatch>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Insider -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Insider">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/ThreatActor"/>
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">A threat actor inside the organisation.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/LowCriticalityAsset -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/LowCriticalityAsset">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCriticality"/>
                        <owl:hasValue>Low</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <cybersecurity:alignmentType>extended</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">FIPS 199 LOW asset.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/LowSeverityIncident -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/LowSeverityIncident">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Incident"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/involvesThreat"/>
                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SevereThreat"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/affectsAsset"/>
                                        <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/LowCriticalityAsset"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/affectsAsset"/>
                                        <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonCriticalAsset"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/involvesThreat"/>
                                        <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonSevereThreat"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:unionOf>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/affectsAsset"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/involvesThreat"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <cybersecurity:alignmentType>new</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">Matrix cells: moderate/low asset x non-severe threat; low asset x severe threat.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/MalwareAttack -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/MalwareAttack">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat"/>
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/MediumSeverityIncident -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/MediumSeverityIncident">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Incident"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/affectsAsset"/>
                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CriticalAsset"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/involvesThreat"/>
                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/involvesThreat"/>
                                        <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonSevereThreat"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/affectsAsset"/>
                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/ModerateCriticalityAsset"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/involvesThreat"/>
                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SevereThreat"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/affectsAsset"/>
                                        <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonCriticalAsset"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <cybersecurity:alignmentType>new</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">Matrix cells: critical asset x non-severe threat; moderate asset x severe threat.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Misconfiguration -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Misconfiguration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Vulnerability"/>
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/ModerateCriticalityAsset -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/ModerateCriticalityAsset">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCriticality"/>
                        <owl:hasValue>Moderate</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <cybersecurity:alignmentType>extended</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">FIPS 199 MODERATE asset.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/MultiFactorAuthentication -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/MultiFactorAuthentication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityControl"/>
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NetworkDevice -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NetworkDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset"/>
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonCriticalAsset -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonCriticalAsset">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/LowCriticalityAsset"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/ModerateCriticalityAsset"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <cybersecurity:alignmentType>new</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">Asset of moderate or low criticality.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonImpactTechnique -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonImpactTechnique">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTechnique"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/partOfTactic"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:complementOf>
                                    <owl:Class>
                                        <owl:oneOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/TA0040"/>
                                        </owl:oneOf>
                                    </owl:Class>
                                </owl:complementOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <cybersecurity:alignmentType>new</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">Technique none of whose tactics is Impact. Requires a closure axiom on the technique.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonSevereThreat -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonSevereThreat">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/exploitsVulnerability"/>
                        <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonSevereVulnerability"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/usesTechnique"/>
                        <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonImpactTechnique"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <cybersecurity:alignmentType>new</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">Threat known (under closure) to use no Impact technique and to exploit only Low/Medium CVSS vulnerabilities.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonSevereVulnerability -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonSevereVulnerability">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Vulnerability"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCVSSScore"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">7.0</xsd:maxExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <cybersecurity:alignmentType>reused</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">CVSS v3.1 rating None/Low/Medium (&lt; 7.0).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/OpenPort -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/OpenPort">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Vulnerability"/>
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/PhishingAttack -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/PhishingAttack">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/usesTechnique"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/T1566"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
        <rdfs:seeAlso rdf:resource="https://attack.mitre.org/techniques/T1566/"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/RansomwareAttack -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/RansomwareAttack">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/MalwareAttack"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/usesTechnique"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/T1486"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/TrojanAttack"/>
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
        <rdfs:seeAlso rdf:resource="https://attack.mitre.org/techniques/T1486/"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityAwarenessTraining -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityAwarenessTraining">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityControl"/>
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityControl -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityControl">
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">A technical or organisational safeguard.</rdfs:comment>
        <skos:closeMatch>STIX 2.1 course-of-action SDO; NIST SP 800-53 control</skos:closeMatch>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Server -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Server">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset"/>
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SevereThreat -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SevereThreat">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/HighImpactThreat"/>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/exploitsVulnerability"/>
                                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SevereVulnerability"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <cybersecurity:alignmentType>new</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">Threat that has high impact (ATT&amp;CK) or exploits a High/Critical CVSS vulnerability.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SevereVulnerability -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SevereVulnerability">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Vulnerability"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCVSSScore"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">7.0</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <cybersecurity:alignmentType>reused</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">CVSS v3.1 qualitative rating High (7.0-8.9) or Critical (9.0-10.0).</rdfs:comment>
        <rdfs:seeAlso rdf:resource="https://www.first.org/cvss/v3.1/specification-document"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat -->

    <owl:Class rdf:about="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat">
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
        <rdfs:comment xml:lang="en">A realised or attempted malicious activity (an attack).</rdfs:comment>
        <skos:closeMatch>UCO uco:Attack; STIX 2.1 attack-pattern SDO</skos:closeMatch>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/ThreatActor -->

