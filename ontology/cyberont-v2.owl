                        <owl:hasValue rdf:resource="http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/T1204"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <cybersecurity:alignmentType>aligned</cybersecurity:alignmentType>
        <rdfs:seeAlso rdf:resource="https://attack.mitre.org/techniques/T1204/"/>
    </owl:Class>
    


