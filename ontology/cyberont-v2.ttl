                                                                                                                                            owl:someValuesFrom <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SevereVulnerability>
                                                                                                                                          ]
                                                                                                                                        ) ;
                                                                                                                     rdf:type owl:Class
                                                                                                                   ]
                                                                                                                 )
                                                                                                   ] ;
                                                                               <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "new" ;
                                                                               rdfs:comment "Threat that has high impact (ATT&CK) or exploits a High/Critical CVSS vulnerability."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SevereVulnerability
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SevereVulnerability> rdf:type owl:Class ;
                                                                                      owl:equivalentClass [ owl:intersectionOf ( <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Vulnerability>
                                                                                                                                 [ rdf:type owl:Restriction ;
                                                                                                                                   owl:onProperty <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCVSSScore> ;
                                                                                                                                   owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                                        owl:onDatatype xsd:decimal ;
                                                                                                                                                        owl:withRestrictions ( [ xsd:minInclusive 7.0
                                                                                                                                                                               ]
                                                                                                                                                                             )
                                                                                                                                                      ]
                                                                                                                                 ]
                                                                                                                               ) ;
                                                                                                            rdf:type owl:Class
                                                                                                          ] ;
                                                                                      <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "reused" ;
                                                                                      rdfs:comment "CVSS v3.1 qualitative rating High (7.0-8.9) or Critical (9.0-10.0)."@en ;
                                                                                      rdfs:seeAlso <https://www.first.org/cvss/v3.1/specification-document> .


