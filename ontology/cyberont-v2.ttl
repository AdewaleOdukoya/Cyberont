                                                                                                                                      [ rdf:type owl:Restriction ;
                                                                                                                                        owl:onProperty <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCriticality> ;
                                                                                                                                        owl:hasValue "Moderate"
                                                                                                                                      ]
                                                                                                                                    ) ;
                                                                                                                 rdf:type owl:Class
                                                                                                               ] ;
                                                                                           <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "extended" ;
                                                                                           rdfs:comment "FIPS 199 MODERATE asset."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/MultiFactorAuthentication
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/MultiFactorAuthentication> rdf:type owl:Class ;
