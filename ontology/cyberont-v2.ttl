                                                                                                                                    [ rdf:type owl:Class ;
                                                                                                                                      owl:unionOf ( [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                                                                                             owl:onProperty <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/affectsAsset> ;
                                                                                                                                                                             owl:someValuesFrom <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CriticalAsset>
                                                                                                                                                                           ]
                                                                                                                                                                           [ rdf:type owl:Restriction ;
                                                                                                                                                                             owl:onProperty <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/involvesThreat> ;
                                                                                                                                                                             owl:someValuesFrom <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat>
                                                                                                                                                                           ]
                                                                                                                                                                           [ rdf:type owl:Restriction ;
                                                                                                                                                                             owl:onProperty <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/involvesThreat> ;
                                                                                                                                                                             owl:allValuesFrom <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonSevereThreat>
                                                                                                                                                                           ]
                                                                                                                                                                         ) ;
                                                                                                                                                      rdf:type owl:Class
                                                                                                                                                    ]
                                                                                                                                                    [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                                                                                             owl:onProperty <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/affectsAsset> ;
                                                                                                                                                                             owl:someValuesFrom <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/ModerateCriticalityAsset>
                                                                                                                                                                           ]
                                                                                                                                                                           [ rdf:type owl:Restriction ;
                                                                                                                                                                             owl:onProperty <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/involvesThreat> ;
                                                                                                                                                                             owl:someValuesFrom <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SevereThreat>
                                                                                                                                                                           ]
                                                                                                                                                                           [ rdf:type owl:Restriction ;
                                                                                                                                                                             owl:onProperty <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/affectsAsset> ;
                                                                                                                                                                             owl:allValuesFrom <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonCriticalAsset>
                                                                                                                                                                           ]
                                                                                                                                                                         ) ;
                                                                                                                                                      rdf:type owl:Class
                                                                                                                                                    ]
                                                                                                                                                  )
                                                                                                                                    ]
                                                                                                                                  ) ;
                                                                                                               rdf:type owl:Class
                                                                                                             ] ;
                                                                                         <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "new" ;
                                                                                         rdfs:comment "Matrix cells: critical asset x non-severe threat; moderate asset x severe threat."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Misconfiguration
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Misconfiguration> rdf:type owl:Class ;
