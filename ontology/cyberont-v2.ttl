@prefix : <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity> .

<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity> rdf:type owl:Ontology ;
                                                                   owl:versionIRI <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/2.0.0> ;
                                                                   rdfs:comment "Version 2 of the cybersecurity incident ontology. Extends v1 with a standards-grounded, closure-based severity model (FIPS 199 asset criticality x CVSS v3.1 band / MITRE ATT&CK Impact tactic, combined following the qualitative risk matrix of NIST SP 800-30 Rev. 1)."@en ;
                                                                   rdfs:label "CyberOnt: Cybersecurity Incident Ontology"@en ;
                                                                   owl:versionInfo "2.0.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/source
dcterms:source rdf:type owl:AnnotationProperty .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> rdf:type owl:AnnotationProperty ;
                                                                                rdfs:comment "How the entity relates to an external standard: reused, aligned, extended or new."@en .


###  http://www.w3.org/2000/01/rdf-schema#seeAlso
rdfs:seeAlso rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#relatedMatch
skos:relatedMatch rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/affectsAsset
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/affectsAsset> rdf:type owl:ObjectProperty ;
                                                                               rdfs:domain <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Incident> ;
                                                                               rdfs:range <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset> ;
                                                                               rdfs:comment "Links an incident to an asset whose confidentiality, integrity or availability it impacts."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/causedBy
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/causedBy> rdf:type owl:ObjectProperty ;
                                                                           rdfs:domain <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Incident> ;
                                                                           rdfs:range <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Actor> ;
                                                                           rdfs:comment "Links an incident to the actor responsible for it."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/exploitsVulnerability
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/exploitsVulnerability> rdf:type owl:ObjectProperty ;
                                                                                        rdfs:domain <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat> ;
                                                                                        rdfs:range <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Vulnerability> ;
                                                                                        rdfs:comment "Links a threat to a weakness it leverages."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/generatedBy
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/generatedBy> rdf:type owl:ObjectProperty ;
                                                                              rdfs:domain <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Alert> ;
                                                                              rdfs:range <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityControl> ;
                                                                              rdfs:comment "Links an alert to the sensor or control that raised it."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasVulnerability
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasVulnerability> rdf:type owl:ObjectProperty ;
                                                                                   rdfs:domain <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset> ;
                                                                                   rdfs:range <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Vulnerability> ;
                                                                                   rdfs:comment "Links an asset to a vulnerability present on it."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/involvesThreat
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/involvesThreat> rdf:type owl:ObjectProperty ;
                                                                                 rdfs:domain <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Incident> ;
                                                                                 rdfs:range <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat> ;
                                                                                 rdfs:comment "Links an incident to a threat (attack) involved in it."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/mitigatesThreat
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/mitigatesThreat> rdf:type owl:ObjectProperty ;
                                                                                  rdfs:domain <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityControl> ;
                                                                                  rdfs:range <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat> ;
                                                                                  rdfs:comment "Links a control to a threat it counters."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/mitigatesVulnerability
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/mitigatesVulnerability> rdf:type owl:ObjectProperty ;
                                                                                         rdfs:domain <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityControl> ;
                                                                                         rdfs:range <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Vulnerability> ;
                                                                                         rdfs:comment "Links a control to a vulnerability it reduces."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/partOfTactic
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/partOfTactic> rdf:type owl:ObjectProperty ;
                                                                               rdfs:domain <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTechnique> ;
                                                                               rdfs:range <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTactic> ;
                                                                               rdfs:comment "Links an ATT&CK technique to the tactic(s) under which ATT&CK lists it."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/protectsAsset
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/protectsAsset> rdf:type owl:ObjectProperty ;
                                                                                rdfs:domain <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityControl> ;
                                                                                rdfs:range <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset> ;
                                                                                rdfs:comment "Links a control to an asset it protects (v1 name: protectsAssets)."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/reportsIncident
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/reportsIncident> rdf:type owl:ObjectProperty ;
                                                                                  rdfs:domain <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Alert> ;
                                                                                  rdfs:range <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Incident> ;
                                                                                  rdfs:comment "Links an alert to the incident it reports."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/targetsAsset
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/targetsAsset> rdf:type owl:ObjectProperty ;
                                                                               rdfs:domain <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat> ;
                                                                               rdfs:range <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset> ;
                                                                               rdfs:comment "Links a threat to an asset it targets (v1 name: targetsAssets)."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/usesTechnique
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/usesTechnique> rdf:type owl:ObjectProperty ;
                                                                                rdfs:domain <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat> ;
                                                                                rdfs:range <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTechnique> ;
                                                                                rdfs:comment "Links a threat to a MITRE ATT&CK technique it employs."@en .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasAttackID
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasAttackID> rdf:type owl:DatatypeProperty ;
                                                                              rdfs:domain [ rdf:type owl:Class ;
                                                                                            owl:unionOf ( <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTactic>
                                                                                                          <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTechnique>
                                                                                                        )
                                                                                          ] ;
                                                                              rdfs:range xsd:string ;
                                                                              rdfs:comment "MITRE ATT&CK identifier, e.g. T1486 or TA0040."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCVEIdentifier
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCVEIdentifier> rdf:type owl:DatatypeProperty ;
                                                                                   rdfs:domain <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Vulnerability> ;
                                                                                   rdfs:range xsd:string ;
                                                                                   rdfs:comment "CVE identifier, where one exists."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCVSSScore
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCVSSScore> rdf:type owl:DatatypeProperty ,
                                                                                        owl:FunctionalProperty ;
                                                                               rdfs:domain <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Vulnerability> ;
                                                                               rdfs:range [ rdf:type rdfs:Datatype ;
                                                                                            owl:onDatatype xsd:decimal ;
                                                                                            owl:withRestrictions ( [ xsd:minInclusive 0.0
                                                                                                                   ]
                                                                                                                   [ xsd:maxInclusive 10.0
                                                                                                                   ]
                                                                                                                 )
                                                                                          ] ;
                                                                               rdfs:comment "CVSS v3.1 base score (0.0-10.0). Functional: one base score per vulnerability record."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCVSSVector
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCVSSVector> rdf:type owl:DatatypeProperty ;
                                                                                rdfs:domain <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Vulnerability> ;
                                                                                rdfs:range xsd:string ;
                                                                                rdfs:comment "CVSS v3.1 vector string."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCriticality
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCriticality> rdf:type owl:DatatypeProperty ,
                                                                                          owl:FunctionalProperty ;
                                                                                 rdfs:domain <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset> ;
                                                                                 rdfs:range [ rdf:type rdfs:Datatype ;
                                                                                              owl:oneOf [ rdf:type rdf:List ;
                                                                                                          rdf:first "High" ;
                                                                                                          rdf:rest [ rdf:type rdf:List ;
                                                                                                                     rdf:first "Low" ;
                                                                                                                     rdf:rest [ rdf:type rdf:List ;
                                                                                                                                rdf:first "Moderate" ;
                                                                                                                                rdf:rest rdf:nil
                                                                                                                              ]
                                                                                                                   ]
                                                                                                        ]
                                                                                            ] ;
                                                                                 rdfs:comment "Business criticality of an asset expressed as a FIPS 199 potential-impact level. Functional."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasHostname
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasHostname> rdf:type owl:DatatypeProperty ;
                                                                              rdfs:domain <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset> ;
                                                                              rdfs:range xsd:string ;
                                                                              rdfs:comment "Host name of an asset."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasIPAddress
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasIPAddress> rdf:type owl:DatatypeProperty ;
                                                                               rdfs:domain <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset> ;
                                                                               rdfs:range xsd:string ;
                                                                               rdfs:comment "IP address of an asset."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasStatus
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasStatus> rdf:type owl:DatatypeProperty ;
                                                                            rdfs:domain [ rdf:type owl:Class ;
                                                                                          owl:unionOf ( <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Alert>
                                                                                                        <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Incident>
                                                                                                      )
                                                                                        ] ;
                                                                            rdfs:range xsd:string ;
                                                                            rdfs:comment "Workflow status, e.g. Open or Closed."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasTimestamp
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasTimestamp> rdf:type owl:DatatypeProperty ;
                                                                               rdfs:domain [ rdf:type owl:Class ;
                                                                                             owl:unionOf ( <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Alert>
                                                                                                           <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Incident>
                                                                                                         )
                                                                                           ] ;
                                                                               rdfs:range xsd:dateTime ;
                                                                               rdfs:comment "Time the incident or alert was recorded (v1 used xsd:string)."@en .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Actor
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Actor> rdf:type owl:Class ;
                                                                        <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "aligned" ;
                                                                        rdfs:comment "An agent involved in a security event."@en ;
                                                                        skos:closeMatch "STIX 2.1 identity / threat-actor" ,
                                                                                        "UCO uco:Attacker (for ThreatActor)" .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Alert
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Alert> rdf:type owl:Class ;
                                                                        <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "aligned" ;
                                                                        rdfs:comment "A notification raised by a security control."@en ;
                                                                        skos:closeMatch "STIX 2.1 sighting SRO" .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Antivirus
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Antivirus> rdf:type owl:Class ;
                                                                            rdfs:subClassOf <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityControl> ;
                                                                            <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "aligned" .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Application
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Application> rdf:type owl:Class ;
                                                                              rdfs:subClassOf <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset> ;
                                                                              <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "aligned" .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTactic
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTactic> rdf:type owl:Class ;
                                                                               <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "reused" ;
                                                                               rdfs:comment "A MITRE ATT&CK tactic (adversary goal)."@en ;
                                                                               rdfs:seeAlso <https://attack.mitre.org/tactics/enterprise/> .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTechnique
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTechnique> rdf:type owl:Class ;
                                                                                  <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "reused" ;
                                                                                  rdfs:comment "A MITRE ATT&CK technique (how a goal is achieved)."@en ;
                                                                                  rdfs:seeAlso <https://attack.mitre.org/techniques/enterprise/> .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/BackupSystem
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/BackupSystem> rdf:type owl:Class ;
                                                                               rdfs:subClassOf <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityControl> ;
                                                                               <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "aligned" .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/BruteForceAttack
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/BruteForceAttack> rdf:type owl:Class ;
                                                                                   rdfs:subClassOf [ owl:intersectionOf ( <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat>
                                                                                                                          [ rdf:type owl:Restriction ;
                                                                                                                            owl:onProperty <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/usesTechnique> ;
                                                                                                                            owl:hasValue <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/T1110>
                                                                                                                          ]
                                                                                                                        ) ;
                                                                                                     rdf:type owl:Class
                                                                                                   ] ;
                                                                                   <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "aligned" ;
                                                                                   rdfs:seeAlso <https://attack.mitre.org/techniques/T1110/> .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CriticalAsset
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CriticalAsset> rdf:type owl:Class ;
                                                                                owl:equivalentClass [ owl:intersectionOf ( <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset>
                                                                                                                           [ rdf:type owl:Restriction ;
                                                                                                                             owl:onProperty <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCriticality> ;
                                                                                                                             owl:hasValue "High"
                                                                                                                           ]
                                                                                                                         ) ;
                                                                                                      rdf:type owl:Class
                                                                                                    ] ;
                                                                                <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "extended" ;
                                                                                rdfs:comment "Asset whose compromise would have a severe or catastrophic adverse effect (FIPS 199 HIGH). Defined, not tagged (v1 asserted it)."@en ;
                                                                                rdfs:seeAlso <https://doi.org/10.6028/NIST.FIPS.199> .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CriticalVulnerability
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CriticalVulnerability> rdf:type owl:Class ;
                                                                                        owl:equivalentClass [ owl:intersectionOf ( <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Vulnerability>
                                                                                                                                   [ rdf:type owl:Restriction ;
                                                                                                                                     owl:onProperty <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCVSSScore> ;
                                                                                                                                     owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                                          owl:onDatatype xsd:decimal ;
                                                                                                                                                          owl:withRestrictions ( [ xsd:minInclusive 9.0
                                                                                                                                                                                 ]
                                                                                                                                                                               )
                                                                                                                                                        ]
                                                                                                                                   ]
                                                                                                                                 ) ;
                                                                                                              rdf:type owl:Class
                                                                                                            ] ;
                                                                                        <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "reused" ;
                                                                                        rdfs:comment "CVSS v3.1 rating Critical."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset> rdf:type owl:Class ;
                                                                             <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "aligned" ;
                                                                             rdfs:comment "Any digital resource of value to the organisation."@en ;
                                                                             skos:closeMatch "NIST CSF 2.0 ID.AM (asset inventory); STIX 2.1 infrastructure SDO" .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/DDoSAttack
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/DDoSAttack> rdf:type owl:Class ;
                                                                             rdfs:subClassOf [ owl:intersectionOf ( <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat>
                                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                                      owl:onProperty <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/usesTechnique> ;
                                                                                                                      owl:hasValue <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/T1498>
                                                                                                                    ]
                                                                                                                  ) ;
                                                                                               rdf:type owl:Class
                                                                                             ] ;
                                                                             <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "aligned" ;
                                                                             rdfs:seeAlso <https://attack.mitre.org/techniques/T1498/> .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/DDoSMitigationService
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/DDoSMitigationService> rdf:type owl:Class ;
                                                                                        rdfs:subClassOf <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityControl> ;
                                                                                        <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "aligned" .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Database
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Database> rdf:type owl:Class ;
                                                                           rdfs:subClassOf <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset> ;
                                                                           <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "aligned" .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/ExternalAttacker
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/ExternalAttacker> rdf:type owl:Class ;
                                                                                   rdfs:subClassOf <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/ThreatActor> ;
                                                                                   owl:disjointWith <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Insider> ;
                                                                                   <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "aligned" ;
                                                                                   rdfs:comment "A threat actor outside the organisation."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/FirewallRule
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/FirewallRule> rdf:type owl:Class ;
                                                                               rdfs:subClassOf <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SecurityControl> ;
                                                                               <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "aligned" .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/HighImpactThreat
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/HighImpactThreat> rdf:type owl:Class ;
                                                                                   owl:equivalentClass [ owl:intersectionOf ( <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat>
                                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                                owl:onProperty <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/usesTechnique> ;
                                                                                                                                owl:someValuesFrom <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/ImpactTechnique>
                                                                                                                              ]
                                                                                                                            ) ;
                                                                                                         rdf:type owl:Class
                                                                                                       ] ;
                                                                                   <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "new" ;
                                                                                   rdfs:comment "Threat employing at least one ATT&CK Impact technique."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/HighSeverityIncident
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/HighSeverityIncident> rdf:type owl:Class ;
                                                                                       owl:equivalentClass [ owl:intersectionOf ( <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Incident>
                                                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                                                    owl:onProperty <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/affectsAsset> ;
                                                                                                                                    owl:someValuesFrom <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CriticalAsset>
                                                                                                                                  ]
                                                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                                                    owl:onProperty <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/involvesThreat> ;
                                                                                                                                    owl:someValuesFrom <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/SevereThreat>
                                                                                                                                  ]
                                                                                                                                ) ;
                                                                                                             rdf:type owl:Class
                                                                                                           ] ;
                                                                                       <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "new" ;
                                                                                       rdfs:comment "Matrix cell: critical asset x severe threat."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/ImpactTechnique
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/ImpactTechnique> rdf:type owl:Class ;
                                                                                  owl:equivalentClass [ owl:intersectionOf ( <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTechnique>
                                                                                                                             [ rdf:type owl:Restriction ;
                                                                                                                               owl:onProperty <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/partOfTactic> ;
                                                                                                                               owl:hasValue <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/TA0040>
                                                                                                                             ]
                                                                                                                           ) ;
                                                                                                        rdf:type owl:Class
                                                                                                      ] ;
                                                                                  <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "new" ;
                                                                                  rdfs:comment "Technique listed under the ATT&CK Impact tactic (TA0040): it directly degrades availability or integrity."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Incident
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Incident> rdf:type owl:Class ;
                                                                           <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "aligned" ;
                                                                           rdfs:comment "An occurrence that jeopardises an asset (NIST SP 800-61)."@en ;
                                                                           skos:closeMatch "STIX 2.1 incident SDO" .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Insider
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Insider> rdf:type owl:Class ;
