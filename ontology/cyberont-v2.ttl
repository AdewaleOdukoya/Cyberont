                                                                                            <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "aligned" .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NetworkDevice
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NetworkDevice> rdf:type owl:Class ;
                                                                                rdfs:subClassOf <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/CyberAsset> ;
                                                                                <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "aligned" .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonCriticalAsset
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonCriticalAsset> rdf:type owl:Class ;
                                                                                   owl:equivalentClass [ rdf:type owl:Class ;
                                                                                                         owl:unionOf ( <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/LowCriticalityAsset>
                                                                                                                       <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/ModerateCriticalityAsset>
                                                                                                                     )
                                                                                                       ] ;
                                                                                   <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "new" ;
                                                                                   rdfs:comment "Asset of moderate or low criticality."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonImpactTechnique
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonImpactTechnique> rdf:type owl:Class ;
                                                                                     owl:equivalentClass [ owl:intersectionOf ( <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/AttackTechnique>
                                                                                                                                [ rdf:type owl:Restriction ;
                                                                                                                                  owl:onProperty <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/partOfTactic> ;
                                                                                                                                  owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                                                                      owl:complementOf [ rdf:type owl:Class ;
                                                                                                                                                                         owl:oneOf ( <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/TA0040>
                                                                                                                                                                                   )
                                                                                                                                                                       ]
                                                                                                                                                    ]
                                                                                                                                ]
                                                                                                                              ) ;
                                                                                                           rdf:type owl:Class
                                                                                                         ] ;
                                                                                     <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "new" ;
                                                                                     rdfs:comment "Technique none of whose tactics is Impact. Requires a closure axiom on the technique."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonSevereThreat
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonSevereThreat> rdf:type owl:Class ;
                                                                                  owl:equivalentClass [ owl:intersectionOf ( <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Threat>
                                                                                                                             [ rdf:type owl:Restriction ;
                                                                                                                               owl:onProperty <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/exploitsVulnerability> ;
                                                                                                                               owl:allValuesFrom <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonSevereVulnerability>
                                                                                                                             ]
                                                                                                                             [ rdf:type owl:Restriction ;
                                                                                                                               owl:onProperty <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/usesTechnique> ;
                                                                                                                               owl:allValuesFrom <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonImpactTechnique>
                                                                                                                             ]
                                                                                                                           ) ;
                                                                                                        rdf:type owl:Class
                                                                                                      ] ;
                                                                                  <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "new" ;
                                                                                  rdfs:comment "Threat known (under closure) to use no Impact technique and to exploit only Low/Medium CVSS vulnerabilities."@en .


###  http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonSevereVulnerability
<http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/NonSevereVulnerability> rdf:type owl:Class ;
                                                                                         owl:equivalentClass [ owl:intersectionOf ( <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/Vulnerability>
                                                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                                                      owl:onProperty <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/hasCVSSScore> ;
                                                                                                                                      owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                                           owl:onDatatype xsd:decimal ;
                                                                                                                                                           owl:withRestrictions ( [ xsd:maxExclusive 7.0
                                                                                                                                                                                  ]
                                                                                                                                                                                )
                                                                                                                                                         ]
                                                                                                                                    ]
                                                                                                                                  ) ;
                                                                                                               rdf:type owl:Class
                                                                                                             ] ;
                                                                                         <http://www.semanticweb.org/mac/ontologies/2025/10/cybersecurity/alignmentType> "reused" ;
                                                                                         rdfs:comment "CVSS v3.1 rating None/Low/Medium (< 7.0)."@en .


